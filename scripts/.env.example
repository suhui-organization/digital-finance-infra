# =============================================================================
# 环境变量配置模板 — digital-finance-lottory 部署
# 使用方式: cp .env.example .env  然后按实际情况修改
# =============================================================================

# ---------- 镜像版本 (所有服务共用) ----------
TAG=latest

# ---------- 数据库 ----------
POSTGRES_DB=digital_finance
POSTGRES_USER=dfuser
# ⚠️ 生产环境务必修改为强密码
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# ---------- Go 后端 ----------
BACKEND_PORT=16080
# ⚠️ 必填: JWT 签名密钥 (生产环境使用 64 位以上随机字符串)
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET_KEY

# ---------- AI 服务 ----------
AI_PORT=16081
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
# ⚠️ 必填: AI 服务 API 密钥
API_KEY=CHANGE_ME_TO_YOUR_API_KEY

# ---------- Nginx 网关 ----------
NGINX_PORT=16000

# ---------- Admin 前端 ----------
ADMIN_PORT=16010
# API 由 Next.js rewrites 在服务端代理到 Nginx Gateway (nginx:80)
# Nginx Gateway 统一转发 /api/* → go-backend:16080, /ai/* → ai-service:16081

# ---------- Mobile 前端 ----------
MOBILE_PORT=16020
# API 由 Next.js rewrites 在服务端代理到 Nginx Gateway (nginx:80)
# Nginx Gateway 统一转发 /api/* → go-backend:16080, /ai/* → ai-service:16081
